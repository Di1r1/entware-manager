{
  "id": "transmission",
  "name": "Transmission",
  "base": "http://127.0.0.1:8090",
  "probe": {
    "url": "/transmission/rpc"
  },
  "status": {
    "url": "/transmission/rpc",
    "method": "POST",
    "body": "{\"method\":\"session-stats\"}"
  },
  "actions": [
    {
      "id": "torrents_start",
      "label": "Запустить все торренты",
      "url": "/transmission/rpc",
      "method": "POST",
      "body": "{\"method\":\"torrent-start\"}",
      "confirm": true
    },
    {
      "id": "torrents_stop",
      "label": "Остановить все торренты",
      "url": "/transmission/rpc",
      "method": "POST",
      "body": "{\"method\":\"torrent-stop\"}",
      "confirm": true
    }
  ],
  "fields": [
    {
      "path": "torrentCount",
      "label": "Всего торрентов",
      "tile": true
    },
    {
      "path": "activeTorrentCount",
      "label": "Активные",
      "tile": true
    },
    {
      "path": "downloadSpeed",
      "label": "Загрузка (Б/с)",
      "tile": true,
      "color": "#8b5cf6"
    },
    {
      "path": "uploadSpeed",
      "label": "Отдача (Б/с)",
      "tile": true,
      "color": "#38a169"
    },
    {
      "path": "pausedTorrentCount",
      "label": "На паузе"
    },
    {
      "path": "cumulative-stats.downloadedBytes",
      "label": "Скачано за всё время",
      "type": "bytes"
    },
    {
      "path": "cumulative-stats.uploadedBytes",
      "label": "Отдано за всё время",
      "type": "bytes"
    }
  ]
}