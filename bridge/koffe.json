{
  "id": "koffe",
  "name": "Koffe VPN",
  "base": "http://127.0.0.1:9097/",
  "probe": {
    "url": "?action=version",
    "expect": "json"
  },
  "status": {
    "url": "?action=status"
  },
  "extra": {
    "failover": {
      "url": "?action=failover_dashboard"
    },
    "health": {
      "url": "?action=server_health_status"
    },
    "history": {
      "url": "?action=stats_history",
      "slice_last": 240
    }
  },
  "actions": [
    {
      "id": "restart",
      "label": "Перезапустить",
      "url": "?action=restart",
      "method": "POST",
      "confirm": true
    }
  ],
  "fields": [
    {
      "path": "running",
      "label": "Туннель",
      "type": "bool"
    },
    {
      "path": "mode",
      "label": "Режим"
    },
    {
      "path": "server",
      "label": "Сервер"
    },
    {
      "path": "split_count",
      "label": "Списки IP: сплит",
      "tile": false
    },
    {
      "path": "device_bypass",
      "label": "Байпас",
      "type": "count"
    },
    {
      "path": "device_tunnel",
      "label": "Туннель устройств",
      "type": "count"
    },
    {
      "path": "uptime",
      "label": "Аптайм"
    },
    {
      "path": "current_name",
      "label": "Failover: активный сервер",
      "from": "failover"
    },
    {
      "path": "last_latency_ms",
      "label": "Пинг до VPS (мс)",
      "from": "health"
    }
  ]
}