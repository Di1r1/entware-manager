{
  "version": "1.1",
  "comment": "Конфигурация модуля Сеть для Entware Manager",
  "sidebar": {
    "update_interval": 30,
    "show_lan": true,
    "show_wifi": true,
    "show_wan": true,
    "show_speed": true
  },
  "watchdog": {
    "enabled": true,
    "interval": 30,
    "watch_interfaces": ["br0", "br1", "br2", "ppp0", "t2s21", "ezcfg0"],
    "watch_internet": true,
    "ping_host": "8.8.8.8",
    "ping_timeout": 5,
    "notify_on": ["interface_down", "no_internet", "ip_changed", "interface_up"]
  },
  "paths": {
    "pid_file": "/tmp/entware/pid/network_watchdog.pid",
    "log_file": "/opt/var/log/entware/network_events.json",
    "state_file": "/tmp/entware/pid/network_watchdog_state.json",
    "config_file": "/opt/web_entware/network_config.json"
  }
}
