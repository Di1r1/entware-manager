#!/bin/sh
# shellcheck disable=SC3037,SC2034,SC2155,SC2086,SC2046,SC3043
# Copyright (c) 2026 Di1r1 — https://github.com/Di1r1/entware-manager
# ==============================================
# Entware Manager: init-скрипт собственного Go-сервера
#
# Используется на роутерах, где есть сторонний lighttpd
# (nfqws/zapret и т.п.) — общий lighttpd-конфиг конфликтует по
# server.port, поэтому менеджер отдаёт entware-server сам:
#   статика (белый список) + CGI через subprocess-glue.
# Порт берётся из /opt/web_entware/server_config.json ({"port": 8087}).
#
# ВНИМАНИЕ: только ash/POSIX, никакого bash/pkill — на роутере их нет.
# ==============================================

ENABLED=yes

DESC="entware-manager server"
SERVER_BIN=""
for c in /opt/web_entware/cgi-bin/go/entware-server \
         /opt/web_entware/cgi-bin/go/*/entware-server; do
	[ -x "$c" ] && { SERVER_BIN="$c"; break; }
done
[ -z "$SERVER_BIN" ] && SERVER_BIN="/opt/web_entware/cgi-bin/go/entware-server"

PIDFILE="/opt/var/run/entware-server.pid"
LOGFILE="/opt/var/log/entware/server.log"
CONFIG_FILE="/opt/web_entware/server_config.json"

# --- Порт из конфига (по умолчанию 8087) ---
PORT=8087
if command -v jq >/dev/null 2>&1 && [ -f "$CONFIG_FILE" ]; then
	p=$(jq -r '.port // 8087' "$CONFIG_FILE" 2>/dev/null)
	case "$p" in
		''|*[!0-9]*) ;;
		*) [ "$p" -gt 0 ] 2>/dev/null && [ "$p" -lt 65536 ] && PORT=$p ;;
	esac
fi
URL_CHECK="http://127.0.0.1:$PORT/entware-cgi/session.cgi"

ansi_green="\033[1;32m"
ansi_red="\033[1;31m"
ansi_white="\033[1;37m"
ansi_std="\033[m"

# --- Живой ли PID из pid-файла (и это entware-server)? ---
pid_from_file() {
	[ -f "$PIDFILE" ] || return 1
	pid=$(cat "$PIDFILE" 2>/dev/null | tr -d ' ')
	[ -n "$pid" ] && [ -d "/proc/$pid" ] || return 1
	cmdline=$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null)
	echo "$cmdline" | grep -q "entware-server" || return 1
	echo "$pid"
	return 0
}

# --- Отвечает ли порт? ---
check_port() {
	command -v curl >/dev/null 2>&1 || return 1
	[ "$(curl -s -o /dev/null -w "%{http_code}" --connect-timeout 2 "$URL_CHECK" 2>/dev/null)" = "200" ]
}

start() {
	if check_port; then
		echo -e "$ansi_white Starting $DESC... $ansi_std            $ansi_green already serving (port $PORT). $ansi_std"
		return 0
	fi
	if pid_from_file >/dev/null; then
		echo -e "$ansi_white Starting $DESC... $ansi_std            $ansi_green already running. $ansi_std"
		return 0
	fi

	mkdir -p /opt/var/log/entware 2>/dev/null
	echo -e -n "$ansi_white Starting $DESC... $ansi_std"
	$SERVER_BIN >/dev/null 2>>"$LOGFILE" &

	COUNTER=0
	LIMIT=10
	while [ $COUNTER -le $LIMIT ]; do
		if check_port || pid_from_file >/dev/null; then
			echo -e "            $ansi_green done. $ansi_std"
			return 0
		fi
		sleep 1
		COUNTER=$((COUNTER + 1))
	done

	echo -e "            $ansi_red failed. $ansi_std"
	echo "      Лог: $LOGFILE"
	return 1
}

stop() {
	echo -e -n "$ansi_white Stopping $DESC... $ansi_std"
	if check_port || pid_from_file >/dev/null; then
		pid=$(pid_from_file)
		[ -n "$pid" ] && kill "$pid" 2>/dev/null
	fi

	COUNTER=0
	LIMIT=10
	while [ $COUNTER -le $LIMIT ]; do
		if check_port || pid_from_file >/dev/null; then
			sleep 1
			COUNTER=$((COUNTER + 1))
		else
			break
		fi
	done

	rm -f "$PIDFILE" 2>/dev/null

	if check_port || pid_from_file >/dev/null; then
		echo -e "            $ansi_red failed. $ansi_std"
		return 1
	fi
	echo -e "            $ansi_green done. $ansi_std"
	return 0
}

restart() {
	stop
	start
}

check() {
	if check_port; then
		echo -e "$ansi_white Checking $DESC... $ansi_std  $ansi_green alive (port $PORT). $ansi_std"
		return 0
	fi
	pid=$(pid_from_file)
	if [ -n "$pid" ]; then
		echo -e "$ansi_white Checking $DESC... $ansi_std  $ansi_green alive (pid $pid). $ansi_std"
		return 0
	fi
	echo -e "$ansi_white Checking $DESC... $ansi_std  $ansi_red dead. $ansi_std"
	return 1
}

case "$1" in
	start) start ;;
	stop|kill) stop ;;
	restart) restart ;;
	check|status) check ;;
	*)
		echo "Usage: $0 (start|stop|restart|check|status)"
		exit 1
		;;
esac
